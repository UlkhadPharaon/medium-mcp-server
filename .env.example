# Medium MCP Server — browser-based configuration
#
# No API tokens are required. The server drives a real Chromium browser and
# authenticates by asking you to sign in to Medium once.
#
# Everything below is OPTIONAL. The defaults work for a normal install.

# ---------------------------------------------------------------------------
# Browser behaviour
# ---------------------------------------------------------------------------

# Keep the browser window VISIBLE. Required while signing in for the first time,
# and strongly recommended for every run: Medium's Cloudflare bot challenge
# serves an interstitial to headless Chromium, which yields empty article reads.
# The session is still reused silently in the background once it exists.
# MEDIUM_HEADLESS=true

# ---------------------------------------------------------------------------
# Session storage
# ---------------------------------------------------------------------------

# Where the login session and the persistent Chrome profile are kept.
# Defaults: %USERPROFILE%\.medium-mcp-session.json and %USERPROFILE%\.medium-mcp-chrome\
# Keep them OUTSIDE the repo so they can never be committed.
# MEDIUM_SESSION_DIR=C:\Users\you\.medium-mcp

# ---------------------------------------------------------------------------
# Legacy (unused)
# ---------------------------------------------------------------------------
# The old API-based version needed MEDIUM_CLIENT_ID / MEDIUM_CLIENT_SECRET.
# The browser-based rewrite does not use them and they are ignored.
